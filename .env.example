# ---------------------------------------------------------------------------
# DASCADE environment. Everything is optional — the arcade runs with no config.
# Copy to .env (never commit real secrets).
# ---------------------------------------------------------------------------

# Game server
PORT=2567
HOST=0.0.0.0
# NODE_ENV=production        # serve the built web client from the game server
# LOG_LEVEL=info             # debug | info | warn | error
# DASCADE_LATENCY_MS=0       # simulate round-trip latency (dev netcode testing)
# DASCADE_ONLY_GAMES=        # e.g. "wheel,bingo" to load only some rooms (dev)
# DASCADE_SAVE_SECRET=       # HMAC secret for DASQuest save files (set in production!)

# Optional Supabase — server side (secret key: server only, NEVER expose to browsers)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...

# Web client (Vite exposes only VITE_* vars to the browser)
# VITE_SERVER_URL=           # game server origin if the client is hosted separately (CDN)
# VITE_SERVER_PORT=2567      # dev only: port of the local game server
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
