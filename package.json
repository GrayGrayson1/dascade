{
  "name": "dascade",
  "private": true,
  "version": "1.0.0",
  "description": "DASCADE — Delta Alpha Sierra Arcade. A multiplayer browser arcade.",
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"pnpm --filter @dascade/game-server dev\" \"pnpm --filter @dascade/web dev\"",
    "build": "pnpm --filter @dascade/web build && pnpm --filter @dascade/game-server build",
    "start": "pnpm --filter @dascade/game-server start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "load": "tsx scripts/load-test.ts",
    "music:index": "tsx scripts/music/index.ts"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@colyseus/testing": "^0.18.6",
    "@dascade/shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
